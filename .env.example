PORT=4175
HOST=127.0.0.1

# Life Graph client integration. Keep secrets in .env, never in repo files.
LIFE_GRAPH_API_BASE_URL=http://127.0.0.1:8787
LIFE_GRAPH_WRITE_TOKEN=
LIFE_GRAPH_IMPORT_MODE=dry_run

# feed = read articles from configured RSS feeds.
# life_graph = read articles from Life Graph /api/intel/works, with feed fallback for local dev.
NEWS_READER_ITEMS_SOURCE=feed

# Optional when running package scripts against a non-default local reader server.
NEWS_READER_BASE_URL=http://127.0.0.1:4175
