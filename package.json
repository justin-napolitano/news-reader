{
  "name": "news-reader",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "contracts": "node scripts/intel-graph-contract-check.js",
    "dev": "node server.js",
    "life-graph:apply": "node scripts/life-graph-client.js apply",
    "life-graph:dry-run": "node scripts/life-graph-client.js local-dry-run",
    "life-graph:push-dry-run": "node scripts/life-graph-client.js remote-dry-run",
    "life-graph:reader-works": "node scripts/life-graph-client.js reader-works",
    "life-graph:retention": "node scripts/life-graph-client.js retention-dry-run",
    "life-graph:sources": "node scripts/life-graph-client.js sources",
    "life-graph:status": "node scripts/life-graph-client.js status",
    "life-graph:works": "node scripts/life-graph-client.js works",
    "start": "node server.js",
    "smoke": "node scripts/intel-graph-contract-check.js && node scripts/smoke-test.js",
    "vercel:domain:add": "node scripts/vercel-add-domain.mjs --apply",
    "vercel:domain:plan": "node scripts/vercel-add-domain.mjs --dry-run",
    "vercel:env:plan": "node scripts/vercel-sync-env.mjs --dry-run",
    "vercel:env:push": "node scripts/vercel-sync-env.mjs --apply",
    "vercel:env:seed": "node scripts/vercel-seed-env.mjs",
    "vercel:pull": "npx vercel@latest pull --yes"
  }
}
