{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://jnap.me/contracts/intel-graph/life-graph-import.schema.json",
  "title": "Intel Graph Life Graph Import",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "target",
    "mode",
    "idempotency_key",
    "generated_at",
    "source_hash",
    "migration_refs",
    "import_run",
    "graph_patch",
    "objects",
    "edges",
    "audit"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "life_graph_import" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*$" },
    "target": { "type": "string", "const": "jnap-life-graph" },
    "mode": { "type": "string", "enum": ["dry_run", "apply"] },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_hash": { "type": "string", "minLength": 1 },
    "migration_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "file", "status", "applies_after"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["proposed", "applied", "superseded"] },
          "applies_after": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "import_run": { "type": "object", "additionalProperties": true },
    "graph_patch": { "type": "object", "additionalProperties": true },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "type",
          "title",
          "summary",
          "visibility",
          "review_state",
          "tags",
          "taxonomy",
          "provenance",
          "projections",
          "payload"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
          "type": { "type": "string", "enum": ["project", "portfolio_piece", "writing", "proof_point", "life_object", "route", "collection"] },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "visibility": { "type": "string", "enum": ["public", "public_review_required", "resume_safe_review_required", "private", "inherited"] },
          "review_state": { "type": "string", "enum": ["discovered", "needs_summary", "curated", "public_ready", "resume_ready", "private", "archived"] },
          "tags": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" }
          },
          "taxonomy": { "type": "object", "additionalProperties": true },
          "links": {
            "type": "array",
            "items": { "type": "object", "additionalProperties": true }
          },
          "relationships": {
            "type": "array",
            "items": { "type": "object", "additionalProperties": true }
          },
          "provenance": { "type": "object", "additionalProperties": true },
          "projections": {
            "type": "array",
            "items": { "type": "object", "additionalProperties": true }
          },
          "payload": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_object_id", "target_object_id", "edge_type", "payload", "source_hash"],
        "properties": {
          "source_object_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
          "target_object_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
          "edge_type": { "type": "string", "minLength": 1 },
          "payload": { "type": "object", "additionalProperties": true },
          "source_hash": { "type": "string", "minLength": 1 }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created", "updated", "skipped", "blocked"],
      "properties": {
        "created": { "type": "integer", "minimum": 0 },
        "updated": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
