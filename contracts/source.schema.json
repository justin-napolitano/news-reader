{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://jnap.me/contracts/intel-graph/source.schema.json",
  "title": "Intel Graph Source",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "source_type", "name", "rights", "provenance"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "source" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*$" },
    "source_type": {
      "type": "string",
      "enum": ["publisher", "feed", "library", "repository", "person", "site", "api"]
    },
    "name": { "type": "string", "minLength": 1 },
    "section": { "type": "string" },
    "source_url": { "type": "string", "format": "uri" },
    "feed_url": { "type": "string", "format": "uri" },
    "allow_hosts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full_text_storage"],
      "properties": {
        "full_text_storage": {
          "type": "string",
          "enum": ["metadata_only", "allowed", "user_owned", "unknown"]
        },
        "notes": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_refs"],
      "properties": {
        "imported_from": { "type": "string" },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

