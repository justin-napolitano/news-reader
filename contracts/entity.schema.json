{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://jnap.me/contracts/intel-graph/entity.schema.json",
  "title": "Intel Graph Entity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "entity_type", "name", "provenance"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "entity" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*$" },
    "entity_type": {
      "type": "string",
      "enum": ["person", "organization", "place", "product", "dataset", "repository", "source", "other"]
    },
    "name": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri" },
    "aliases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "evidence_refs"],
      "properties": {
        "source": { "type": "string", "enum": ["user", "agent", "importer", "system"] },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

