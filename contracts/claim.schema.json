{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://jnap.me/contracts/intel-graph/claim.schema.json",
  "title": "Intel Graph Claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "claim_type", "text", "status", "provenance"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "claim" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*$" },
    "claim_type": {
      "type": "string",
      "enum": ["source_claim", "user_claim", "definition", "mechanism", "synthesis", "model_inference", "open_question"]
    },
    "text": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["needs_evidence", "source_backed", "user_authored", "agent_inferred", "reviewed", "rejected"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authored_by", "evidence_refs"],
      "properties": {
        "authored_by": { "type": "string", "enum": ["user", "agent", "importer", "source"] },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "assumptions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

