{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://jnap.me/contracts/intel-graph/import-run.schema.json",
  "title": "Intel Graph Import Run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "importer_id", "source", "idempotency_key", "started_at", "status", "counts"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "import_run" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*$" },
    "importer_id": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "enum": ["source", "feed", "api", "file"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["started", "completed", "completed_with_errors", "blocked", "failed"] },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seen", "created", "updated", "skipped", "blocked"],
      "properties": {
        "seen": { "type": "integer", "minimum": 0 },
        "created": { "type": "integer", "minimum": 0 },
        "updated": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "source_ref": { "type": "string" }
        }
      }
    }
  }
}

