{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://jnap.me/contracts/intel-graph/relevance-result.schema.json",
  "title": "Intel Graph Relevance Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "algorithm", "query", "candidate", "score", "reason_codes", "evidence_refs", "missing_evidence_refs", "tie_breaker", "mutation_policy"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "relevance_result" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*$" },
    "algorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent"],
      "properties": {
        "intent": { "type": "string", "minLength": 1 },
        "terms": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "enum": ["source", "work", "annotation", "topic", "entity", "claim", "project_connection"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "missing_evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "tie_breaker": { "type": "string", "minLength": 1 },
    "confidence_note": { "type": "string" },
    "mutation_policy": { "type": "string", "enum": ["advisory_only", "requires_graph_patch", "requires_human_review"] }
  }
}
