{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://jnap.me/contracts/intel-graph/topic.schema.json",
  "title": "Intel Graph Topic",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "label", "provenance"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "topic" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*$" },
    "label": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "aliases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "type": "string", "enum": ["user", "agent", "importer", "system"] },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

