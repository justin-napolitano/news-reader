{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://jnap.me/contracts/intel-graph/graph-patch.schema.json",
  "title": "Intel Graph Patch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "patch_type", "idempotency_key", "mode", "operations", "audit"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "graph_patch" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*$" },
    "patch_type": { "type": "string", "enum": ["migration", "import", "user_edit", "agent_suggestion", "correction"] },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "enum": ["dry_run", "apply"] },
    "preconditions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "object_kind", "object_id", "payload"],
        "properties": {
          "op": { "type": "string", "enum": ["upsert", "delete", "connect", "disconnect"] },
          "object_kind": {
            "type": "string",
            "enum": ["source", "work", "intake_event", "annotation", "topic", "entity", "claim", "project_connection"]
          },
          "object_id": { "type": "string", "minLength": 1 },
          "payload": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created", "updated", "skipped", "blocked"],
      "properties": {
        "created": { "type": "integer", "minimum": 0 },
        "updated": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}

