{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://jnap.me/contracts/intel-graph/work.schema.json",
  "title": "Intel Graph Work",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "work_type", "title", "url", "source_id", "rights", "provenance"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "work" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*$" },
    "work_type": {
      "type": "string",
      "enum": ["article", "book", "paper", "post", "video", "podcast_episode", "repository", "document", "note"]
    },
    "title": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri" },
    "source_id": { "type": "string", "minLength": 1 },
    "source_name": { "type": "string" },
    "section": { "type": "string" },
    "published_at": { "type": "string", "format": "date-time" },
    "excerpt": { "type": "string" },
    "identifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "value"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "value": { "type": "string", "minLength": 1 }
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full_text_storage"],
      "properties": {
        "full_text_storage": {
          "type": "string",
          "enum": ["metadata_only", "allowed", "user_owned", "unknown"]
        },
        "notes": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_item_id", "evidence_refs"],
      "properties": {
        "source_item_id": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

